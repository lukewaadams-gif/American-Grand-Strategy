#!/usr/bin/env bash
# Runs the game (or a designer tool: ./mandate batch 1000, ./mandate weeks, ...). Builds the single jar if it is missing.
set -euo pipefail
cd "$(dirname "$0")"
if [ ! -f mandate-cli/target/mandate.jar ]; then
  mvn -q -B -DskipTests install
fi
exec java -jar mandate-cli/target/mandate.jar "$@"
