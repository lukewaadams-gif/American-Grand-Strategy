{
  "name": "american-grand-strategy",
  "private": true,
  "type": "module",
  "description": "American Grand Strategy: the web front end (TypeScript and PixiJS) over the Rust simulation compiled to WebAssembly.",
  "scripts": {
    "world": "node ../tools/build-world.mjs",
    "sim": "node ../tools/build-sim.mjs",
    "build": "node ../tools/build-sim.mjs && node ../tools/build-world.mjs && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../sim && cargo test --release",
    "play": "node test/playthrough.cjs shots 8795",
    "mods": "node test/mods.cjs 8795",
    "a11y": "node test/a11y.cjs 8795",
    "artifact": "node build-artifact.mjs"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "binaryen": "119.0.0",
    "esbuild": "0.27.0",
    "typescript": "6.0.3",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  }
}
